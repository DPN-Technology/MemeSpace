# DPN MemeSpace staging image. Deploy only behind the HTTPS + access-controlled proxy.
# Node.js native SQLite stays on a dedicated persistent Docker volume.
FROM node:24-bookworm-slim AS build
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY . .
RUN npm exec --yes --package=pnpm@11.25.0 -- pnpm install --frozen-lockfile --prod=false \
    && node scripts/local.mjs build \
    && rm -rf /app/data /app/backups

FROM node:24-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    MEMESPACE_PORT=5173 \
    MEMESPACE_DATA_DIR=/app/data \
    MEMESPACE_BIND_HOST=0.0.0.0
COPY --from=build --chown=node:node /app /app
RUN mkdir -p /app/data && chown node:node /app/data
USER node
EXPOSE 5173
HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:5173/api/health').then(async r=>process.exit(r.ok&&(await r.json()).ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "scripts/local.mjs", "serve"]
